#!/usr/bin/env bash
set -e -o pipefail

repo_root="$( cd "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"

function buildx_15_17_trixie_postgres { # [...docker buildx build flags]: builds multi-arch factalinc/postgres:15.17-trixie image
  docker buildx build --platform linux/arm64/v8,linux/amd64 --tag factalinc/postgres:15.17-trixie "$repo_root/15.17/trixie/postgres" "$@"
}

function buildx_15_17_trixie_postgis { # [...docker buildx build flags]: builds multi-arch factalinc/postgis:3-15.17-trixie image
  docker buildx build --platform linux/arm64/v8,linux/amd64 --tag factalinc/postgis:3-15.17-trixie "$repo_root/15.17/trixie/postgis" "$@"
}

function buildx_15_19_trixie_postgres { # [...docker buildx build flags]: builds multi-arch factalinc/postgres:15.19-trixie image
  docker buildx build --platform linux/arm64/v8,linux/amd64 --tag factalinc/postgres:15.19-trixie "$repo_root/15.19/trixie/postgres" "$@"
}

function buildx_15_19_trixie_postgis { # [...docker buildx build flags]: builds multi-arch factalinc/postgis:3-15.19-trixie image
  docker buildx build --platform linux/arm64/v8,linux/amd64 --tag factalinc/postgis:3-15.19-trixie "$repo_root/15.19/trixie/postgis" "$@"
}

function buildx_18_6_trixie_postgres { # [...docker buildx build flags]: builds multi-arch factalinc/postgres:18.6-trixie image
  docker buildx build --platform linux/arm64/v8,linux/amd64 --tag factalinc/postgres:18.6-trixie "$repo_root/18.6/trixie/postgres" "$@"
}

function buildx_18_6_trixie_postgis { # [...docker buildx build flags]: builds multi-arch factalinc/postgis:3-18.6-trixie image
  docker buildx build --platform linux/arm64/v8,linux/amd64 --tag factalinc/postgis:3-18.6-trixie "$repo_root/18.6/trixie/postgis" "$@"
}

function build_15_17_trixie_postgis { # [...docker buildx build flags]: builds factalinc/postgis:3-15.17-trixie image for only the currect arch
  docker buildx build --tag factalinc/postgis:3-15.17-trixie "$repo_root/15.17/trixie/postgis" "$@"
}

function build_15_17_trixie_postgres { # [...docker buildx build flags]: builds factalinc/postgres:15.17-trixie image for only the currect arch
  docker buildx build --tag factalinc/postgres:15.17-trixie "$repo_root/15.17/trixie/postgres" "$@"
}

function build_15_19_trixie_postgis { # [...docker buildx build flags]: builds factalinc/postgis:3-15.19-trixie image for only the currect arch
  docker buildx build --tag factalinc/postgis:3-15.19-trixie "$repo_root/15.19/trixie/postgis" "$@"
}

function build_15_19_trixie_postgres { # [...docker buildx build flags]: builds factalinc/postgres:15.19-trixie image for only the currect arch
  docker buildx build --tag factalinc/postgres:15.19-trixie "$repo_root/15.19/trixie/postgres" "$@"
}

function build_18_6_trixie_postgis { # [...docker buildx build flags]: builds factalinc/postgis:3-18.6-trixie image for only the currect arch
  docker buildx build --tag factalinc/postgis:3-18.6-trixie "$repo_root/18.6/trixie/postgis" "$@"
}

function build_18_6_trixie_postgres { # [...docker buildx build flags]: builds factalinc/postgres:18.6-trixie image for only the currect arch
  docker buildx build --tag factalinc/postgres:18.6-trixie "$repo_root/18.6/trixie/postgres" "$@"
}

function remove_15_17_trixie_postgres { # [...docker image rm flags]: removes factalinc/postgres:15.17-trixie image
  docker image rm --force factalinc/postgres:15.17-trixie "$@"
}

function remove_15_17_trixie_postgis { # [...docker image rm flags]: removes factalinc/postgis:3-15.17-trixie image
  docker image rm --force factalinc/postgis:3-15.17-trixie "$@"
}

function remove_15_19_trixie_postgres { # [...docker image rm flags]: removes factalinc/postgres:15.19-trixie image
  docker image rm --force factalinc/postgres:15.19-trixie "$@"
}

function remove_15_19_trixie_postgis { # [...docker image rm flags]: removes factalinc/postgis:3-15.19-trixie image
  docker image rm --force factalinc/postgis:3-15.19-trixie "$@"
}

function remove_18_6_trixie_postgres { # [...docker image rm flags]: removes factalinc/postgres:18.6-trixie image
  docker image rm --force factalinc/postgres:18.6-trixie "$@"
}

function remove_18_6_trixie_postgis { # [...docker image rm flags]: removes factalinc/postgis:3-18.6-trixie image
  docker image rm --force factalinc/postgis:3-18.6-trixie "$@"
}

function buildx_all { # [...docker buildx build flags]: builds multi-arch postgres and postgis images
  buildx_15_17_trixie_postgres "$@"
  buildx_15_17_trixie_postgis "$@"
  buildx_15_19_trixie_postgres "$@"
  buildx_15_19_trixie_postgis "$@"
  buildx_18_6_trixie_postgres "$@"
  buildx_18_6_trixie_postgis "$@"
}

function buildx_all_trixie { # [...docker buildx build flags]: builds multi-arch postgres and postgis images
  buildx_15_17_trixie_postgres "$@"
  buildx_15_17_trixie_postgis "$@"
  buildx_15_19_trixie_postgres "$@"
  buildx_15_19_trixie_postgis "$@"
  buildx_18_6_trixie_postgres "$@"
  buildx_18_6_trixie_postgis "$@"
}

function remove_all { # [...docker image rm flags]: removes images
  remove_15_17_trixie_postgres "$@"
  remove_15_17_trixie_postgis "$@"
  remove_15_19_trixie_postgres "$@"
  remove_15_19_trixie_postgis "$@"
  remove_18_6_trixie_postgres "$@"
  remove_18_6_trixie_postgis "$@"
}

if [[ $# -eq 0 || "$1" == "help" ]]; then
  sed -En 's/^function (.*) \{( #)?/\1/p' "$0"
else
  "$@"
fi
